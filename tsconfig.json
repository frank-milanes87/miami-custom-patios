{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "types": ["bun"]
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "client",
    "tests"
  ]
}